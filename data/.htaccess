# ChatApp — data/ directory hardening.
# All user-generated content under data/ is served ONLY through PHP endpoints
# (file.php, avatar.php, emoji.php, temp.php, incident.php, settings.php).
# PHP filesystem access is not affected by .htaccess, so these rules only block
# direct HTTP access / script execution, which is exactly what we want.

# Never allow directory listing of any data/ subfolder.
Options -Indexes

# Never execute or serve script / HTML files as-is.
# 另外禁止直接访问 .log（AI 代理的错误黑匣子日志就放在 data/ 下）。
<FilesMatch "\.(php|phtml|pht|phar|php[0-9]|shtml|html|htm|log)$">
    Require all denied
</FilesMatch>
