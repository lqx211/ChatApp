# =================== AVD / uiautomator dumps (dev reference only) ===================
# adb 抓取的 UI 参考文件（每次跑 update() 会重新生成），不进仓库
a.txt
u.xml

# =================== User-generated / runtime data ===================
# Custom emoji (user-uploaded)
data/ce/*
data/cep/*
data/ticket/*
data/sc/*

# User uploads
data/user/*

# Tickets
data/ticket/*

# Donation records
data/donation/*

# Screenshots / screen captures
data/sc/*

# OOBE 完成标记 / 升级锁（运行时状态，不入库）
data/oobe.done
data/upgrade.lock
data/upgrade_progress.json
data/factory_reset_state.json

# Temporary / cache resources (keep directory, ignore content)
data/res/fileicon/*
data/res/sound/*
data/res/wallpaper/*
# data/res/svg/* is NOT ignored — those SVG icons are app assets referenced by the UI and must ship with the repo.

# =================== Sensitive config (track example files only) ===================
# maintenance/config.php contains credentials — use config.example.php instead
maintenance/config.php
# data/maint_config.php is the web-writable runtime copy of maintenance credentials
# (written by OOBE when maintenance/config.php is read-only, e.g. on macOS/local).
data/maint_config.php
# data/maintenance_status.php is the web-writable runtime copy of maintenance status
# (written by the Maintenance Portal; preferred over root status.php when read-only).
data/maintenance_status.php

# =================== Keep directory structure ===================
# Ensure empty directories are tracked via .gitkeep
# (setup.sh will create .gitkeep files where needed)

# =================== Vendored icon source (not used at runtime) ===================
data/res/brand/src/

# Python
__pycache__/
*.pyc
